# Keep this file as an example. Put real values only in .env, which is ignored by Git.
TELEGRAM_BOT_TOKEN=123456:replace-with-your-bot-token
TELEGRAM_BOT_USERNAME=YourShopBot
TELEGRAM_WEBHOOK_SECRET=use-a-long-random-secret-here
PUBLIC_BASE_URL=https://your-domain.example
PORT=3000

# Telegram Stars price. This is a whole number of Stars, not INR or USD.
PRODUCT_KEY=creative_starter
PRODUCT_TITLE=Creative Starter Pack
PRODUCT_DESCRIPTION=12 editable templates
PRODUCT_PRICE_STARS=150

# Optional: a file to send after a verified payment. It must be inside ./content.
PRODUCT_DELIVERY_FILE=content/creative-starter.zip
SUPPORT_TEXT=Reply with your order number and we will help you.
TERMS_TEXT=Add your terms, refund policy, and support contact before launch.
